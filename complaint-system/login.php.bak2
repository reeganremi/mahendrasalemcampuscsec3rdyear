<?php
// Login for both students and admins (role comes from DB, never from the form).
if (session_status() === PHP_SESSION_NONE) { session_start(); }
require_once __DIR__ . '/config/database.php';
require_once __DIR__ . '/includes/functions.php';

if (is_logged_in()) {
    redirect($_SESSION['user_role'] === 'admin' ? BASE_URL . '/admin/dashboard.php' : BASE_URL . '/dashboard.php');
}

$error = '';
$info = '';
if (isset($_GET['registered'])) $info = 'Account created! Please log in with your new credentials.';
if (isset($_GET['deactivated'])) $error = 'Your account has been deactivated. Please contact the administration.';
if ($f = get_flash()) { if ($f['type'] === 'success') $info = $f['message']; else $error = $f['message']; }
$oldEmail = '';

if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    if (!verify_csrf($_POST['csrf_token'] ?? null)) {
        $error = 'Security check failed. Please reload and try again.';
    } else {
        $email = trim($_POST['email'] ?? '');
        $pass  = $_POST['password'] ?? '';
        $oldEmail = $email;

        if ($email === '' || $pass === '') {
            $error = 'Please enter both email and password.';
        } elseif (!filter_var($email, FILTER_VALIDATE_EMAIL)) {
            $error = 'Please enter a valid email address.';
        } else {
            // Prepared statement — never interpolate user input into SQL.
            $stmt = $conn->prepare('SELECT id, name, email, password, role, is_active FROM users WHERE email = ? LIMIT 1');
            $stmt->bind_param('s', $email);
            $stmt->execute();
            $user = $stmt->get_result()->fetch_assoc();
            $stmt->close();

            if (!$user || !password_verify($pass, $user['password'])) {
                $error = 'Invalid email or password.';
            } elseif ((int)$user['is_active'] === 0) {
                $error = 'Your account has been deactivated. Please contact the administration.';
            } else {
                // Success — regenerate session ID to prevent fixation.
                session_regenerate_id(true);
                $_SESSION['user_id']   = (int)$user['id'];
                $_SESSION['user_name'] = $user['name'];
                $_SESSION['user_role'] = $user['role'];
                // CSRF token rotation per session
                $_SESSION['csrf_token'] = bin2hex(random_bytes(32));
                set_flash('Welcome back, ' . $user['name'] . '!', 'success');

                $next = $_SESSION['redirect_after_login'] ?? null;
                unset($_SESSION['redirect_after_login']);
                if ($next && str_starts_with($next, BASE_URL)) { redirect($next); }
                redirect($user['role'] === 'admin' ? BASE_URL . '/admin/dashboard.php' : BASE_URL . '/dashboard.php');
            }
        }
    }
}
?>
